    <string name="reality_faq_title">What is Reality?</string>
    <string name="reality_faq_body">Reality is an advanced TLS protocol that makes your VPN connection look like regular HTTPS traffic to a popular website. It uses certificate pinning and client hello randomization to defeat DPI and SNI-based blocking.</string>
    <string name="reality_faq_ok">Got it</string>


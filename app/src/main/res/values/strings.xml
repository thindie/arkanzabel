    <!-- Mux settings -->
    <string name="settings_section_mux">Multiplexing (Mux)</string>
    <string name="settings_mux_title">Enable Mux</string>
    <string name="settings_mux_subtitle">Share single connection across multiple streams</string>
    <string name="mux_faq_title">What is Mux?</string>
    <string name="mux_faq_body">Multiplexing (Mux) allows multiple TCP connections to share a single underlying transport connection. This reduces latency and improves performance, especially on high-latency networks like satellite or mobile data.</string>
    <string name="mux_faq_ok">Got it</string>

    <!-- Fragment settings -->
    <string name="settings_fragment_title">Fragmentation</string>
    <string name="settings_fragment_subtitle">Split packets to bypass DPI inspection</string>
    <string name="settings_fragment_subtitle_off">Disabled</string>
    <string name="settings_fragment_hint">Interval between fragments in milliseconds (0 = random)</string>
    <string name="settings_fragment_interval_placeholder">e.g. 10-50</string>
    <string name="fragment_faq_title">What is Fragmentation?</string>
    <string name="fragment_faq_body">Packet fragmentation splits TCP packets into smaller pieces with random intervals between them. This makes it harder for Deep Packet Inspection (DPI) systems to recognize and block VPN traffic patterns.</string>
    <string name="fragment_faq_ok">Got it</string>

    <!-- Reality settings -->
    <string name="settings_section_reality">Reality</string>
    <string name="settings_reality_show_title">Reality (masquerade)</string>
    <string name="settings_reality_show_subtitle_off">Disabled</string>
    <string name="settings_reality_show_subtitle_on">Masquerade enabled</string>
    <string name="reality_faq_title">What is Reality?</string>
    <string name="reality_faq_body">Reality is an advanced TLS protocol that makes your VPN connection look like regular HTTPS traffic to a popular website. It uses certificate pinning and client hello randomization to defeat DPI and SNI-based blocking.</string>
    <string name="reality_faq_ok">Got it</string>


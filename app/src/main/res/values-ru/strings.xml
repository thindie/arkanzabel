    <!-- Mux settings -->
    <string name="settings_section_mux">Мультиплексирование (Mux)</string>
    <string name="settings_mux_title">Включить Mux</string>
    <string name="settings_mux_subtitle">Общий канал для нескольких потоков</string>
    <string name="mux_faq_title">Что такое Mux?</string>
    <string name="mux_faq_body">Мультиплексирование (Mux) позволяет нескольким TCP-соединениям использовать один базовый транспортный канал. Это снижает задержку и улучшает производительность, особенно на сетях с высокой задержкой, таких как спутниковые или мобильные.</string>
    <string name="mux_faq_ok">Понятно</string>

    <!-- Fragment settings -->
    <string name="settings_fragment_title">Фрагментация</string>
    <string name="settings_fragment_subtitle">Разделение пакетов для обхода DPI</string>
    <string name="settings_fragment_subtitle_off">Отключено</string>
    <string name="settings_fragment_hint">Интервал между фрагментами в миллисекундах (0 = случайный)</string>
    <string name="settings_fragment_interval_placeholder">напр. 10–50</string>
    <string name="fragment_faq_title">Что такое Фрагментация?</string>
    <string name="fragment_faq_body">Фрагментация пакетов разделяет TCP-пакеты на более мелкие части со случайными интервалами между ними. Это затрудняет распознавание и блокировку трафика VPN системами глубокого анализа пакетов (DPI).</string>
    <string name="fragment_faq_ok">Понятно</string>

    <!-- Reality settings -->
    <string name="settings_section_reality">Reality</string>
    <string name="settings_reality_show_title">Reality (маскировка)</string>
    <string name="settings_reality_show_subtitle_off">Отключено</string>
    <string name="settings_reality_show_subtitle_on">Маскировка включена</string>
    <string name="reality_faq_title">Что такое Reality?</string>
    <string name="reality_faq_body">Reality — это продвинутый TLS-протокол, который делает ваше VPN-соединение похожим на обычный HTTPS-трафик к популярному сайту. Использует привязку сертификатов и рандомизацию client hello для обхода DPI и блокировок по SNI.</string>
    <string name="reality_faq_ok">Понятно</string>

